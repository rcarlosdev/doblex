# Configuración de la aplicación
PROJECT_NAME="Doblex SMU API"
API_V1_STR="/api"
SECRET_KEY="doblex_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de datos: SQLite para desarrollo local ágil, o descomentar PostgreSQL
DATABASE_URL="sqlite:///./doblex.db"
# DATABASE_URL="postgresql+psycopg2://doblex_user:doblex_password@127.0.0.1:5432/doblex_smu"

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000"

# Directorio de evidencias multimedia
UPLOAD_DIR="./uploads"
